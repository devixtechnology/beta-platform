@using BetaPlatform.Data.Entities
@model BetaPlatform.Data.Entities.WorkOrder
@{
    ViewData["Title"] = Model.WorkOrderNumber;
    string StatusText(WorkOrderStatus s) => s switch
    {
        WorkOrderStatus.Ready => Localizer["Ready"].Value,
        WorkOrderStatus.InProgress => Localizer["InProgress"].Value,
        WorkOrderStatus.OnHold => Localizer["OnHold"].Value,
        WorkOrderStatus.Finished => Localizer["Finished"].Value,
        _ => s.ToString()
    };
    string StatusClass(WorkOrderStatus s) => s switch
    {
        WorkOrderStatus.InProgress => "running",
        WorkOrderStatus.OnHold => "stopped",
        WorkOrderStatus.Finished => "unknown",
        _ => "unknown"
    };
    bool canRecordInputs = Model.Status == WorkOrderStatus.InProgress || Model.Status == WorkOrderStatus.OnHold;
}

<div class="page-header">
    <h1 class="page-title">
        <span class="title-icon"><i class="bi bi-clipboard-data"></i></span>@Model.WorkOrderNumber
        <span class="status-badge @StatusClass(Model.Status) ms-2">@StatusText(Model.Status)</span>
    </h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i>@Localizer["Back"]</a>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-info-circle me-2"></i>@Localizer["Details"]</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">@Localizer["Status"]</dt><dd class="col-7">@StatusText(Model.Status)</dd>
                    <dt class="col-5 text-muted">@Localizer["InputProduct"]</dt><dd class="col-7">@Model.InputProduct?.ProductName</dd>
                    <dt class="col-5 text-muted">@Localizer["OutputProduct"]</dt><dd class="col-7">@Model.OutputProduct?.ProductName</dd>
                    <dt class="col-5 text-muted">@Localizer["AssignedMachine"]</dt><dd class="col-7">@Model.Machine?.MachineName</dd>
                    <dt class="col-5 text-muted">@Localizer["QtyToManufacture"]</dt><dd class="col-7">@Model.QtyToManufacture</dd>
                    <dt class="col-5 text-muted">@Localizer["HourRate"]</dt><dd class="col-7">@(Model.HourRate?.ToString("0.##") ?? "—")</dd>
                    <dt class="col-5 text-muted">@Localizer["LineSetupTime"]</dt><dd class="col-7">@(Model.LineSetupTimeMinutes.HasValue ? $"{Model.LineSetupTimeMinutes} {Localizer["Minutes"].Value}" : "—")</dd>
                    <dt class="col-5 text-muted">@Localizer["WorkstationCapability"]</dt><dd class="col-7">@(Model.WorkstationCapabilityPerHour?.ToString("0.##") ?? "—")</dd>
                    <dt class="col-5 text-muted">@Localizer["PlannedStartTime"]</dt><dd class="col-7">@Model.PlannedStartTime.ToString("yyyy-MM-dd HH:mm")</dd>
                    <dt class="col-5 text-muted">@Localizer["StartedAt"]</dt><dd class="col-7">@(Model.FirstStartedAt?.ToString("yyyy-MM-dd HH:mm") ?? Model.StartedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                    <dt class="col-5 text-muted">@Localizer["FinishedAt"]</dt><dd class="col-7">@(Model.FinishedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                    @{
                        // Actual runtime excludes every hold period — see WorkOrder.ActiveDuration.
                        var runtime = Model.ActiveDuration;
                    }
                    <dt class="col-5 text-muted">@Localizer["ActualRuntime"]</dt><dd class="col-7">@(runtime is null ? "—" : $"{(int)runtime.Value.TotalHours:00}:{runtime.Value.Minutes:00}")</dd>
                </dl>
            </div>
        </div>

        <!-- Lifecycle actions -->
        <div class="mt-3 d-flex gap-2 flex-wrap">
            @if (Model.Status == WorkOrderStatus.Ready)
            {
                <form asp-action="Start" asp-route-id="@Model.WorkOrderId" method="post"><button class="btn btn-success"><i class="bi bi-play-fill"></i>@Localizer["Start"]</button></form>
                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.WorkOrderId"><i class="bi bi-pencil"></i>@Localizer["Edit"]</a>
            }
            @if (Model.Status == WorkOrderStatus.InProgress)
            {
                <form asp-action="Hold" asp-route-id="@Model.WorkOrderId" method="post"><button class="btn btn-warning"><i class="bi bi-pause-fill"></i>@Localizer["Hold"]</button></form>
                <form asp-action="Finish" asp-route-id="@Model.WorkOrderId" method="post"><button class="btn btn-primary"><i class="bi bi-check-lg"></i>@Localizer["Finish"]</button></form>
            }
            @if (Model.Status == WorkOrderStatus.OnHold)
            {
                <form asp-action="Resume" asp-route-id="@Model.WorkOrderId" method="post"><button class="btn btn-success"><i class="bi bi-play-fill"></i>@Localizer["Resume"]</button></form>
            }
            @if (Model.Status != WorkOrderStatus.Finished)
            {
                <form asp-action="Delete" asp-route-id="@Model.WorkOrderId" method="post" onsubmit="return confirm('@Localizer["Delete"]?');">
                    <button class="btn btn-outline-danger"><i class="bi bi-trash"></i>@Localizer["Delete"]</button>
                </form>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <!-- Single output: live Total Weight + Total Count from telemetry (polled ~10s) -->
        <div class="card" id="liveOutput" data-order-id="@Model.WorkOrderId">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-box me-2"></i>@Localizer["Output"]</span>
                <span class="text-muted small"><i class="bi bi-arrow-repeat me-1"></i><span id="liveOutputStamp"></span></span>
            </div>
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-6">
                        <p class="stat-value mb-0" id="liveTotalWeight">—</p>
                        <p class="stat-label">@Localizer["TotalWeight"]</p>
                    </div>
                    <div class="col-6">
                        <p class="stat-value mb-0" id="liveTotalCount">—</p>
                        <p class="stat-label">@Localizer["TotalCount"]</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inputs: weight-only records, no code / no tracing -->
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-box-arrow-in-down me-2"></i>@Localizer["Inputs"]</span>
                <span class="badge status-badge unknown">@Model.Inputs.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Inputs.Any())
                {
                    <div class="text-center text-muted py-4"><i class="bi bi-inbox d-block fs-4 mb-2"></i>@Localizer["NoRecords"]</div>
                }
                else
                {
                    <div class="table-responsive table-scroll">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead><tr><th>#</th><th>@Localizer["Weight"]</th>@if (canRecordInputs) { <th class="text-end">@Localizer["Actions"]</th> }</tr></thead>
                        <tbody>
                        @{ var orderedInputs = Model.Inputs.OrderBy(i => i.InputId).ToList(); }
                        @for (var idx = 0; idx < orderedInputs.Count; idx++)
                        {
                            var inp = orderedInputs[idx];
                            <tr>
                                <td>@(idx + 1)</td>
                                <td>@inp.Weight</td>
                                @if (canRecordInputs)
                                {
                                    <td class="text-end">
                                        <form asp-action="DeleteInput" asp-route-id="@Model.WorkOrderId" method="post" class="d-inline">
                                            <input type="hidden" name="inputId" value="@inp.InputId" />
                                            <button class="btn btn-sm btn-outline-danger" title="@Localizer["Delete"]"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold"><td>@Localizer["TotalInputWeight"]</td><td colspan="@(canRecordInputs ? 2 : 1)">@Model.TotalInputWeight</td></tr>
                        </tfoot>
                    </table>
                    </div>
                }
            </div>
        </div>

        @if (canRecordInputs)
        {
            <div class="card mt-3"><div class="card-body">
                <form asp-action="AddInput" asp-route-id="@Model.WorkOrderId" method="post" class="row g-2 align-items-end">
                    <div class="col-8">
                        <label class="form-label small">@Localizer["Weight"]</label>
                        <input name="weight" type="number" step="0.01" min="0.01" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-4">
                        <button class="btn btn-sm btn-primary w-100"><i class="bi bi-plus-lg"></i>@Localizer["AddInput"]</button>
                    </div>
                </form>
            </div></div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            "use strict";
            var host = document.getElementById("liveOutput");
            if (!host) return;
            var id = host.getAttribute("data-order-id");
            var weightEl = document.getElementById("liveTotalWeight");
            var countEl = document.getElementById("liveTotalCount");
            var stampEl = document.getElementById("liveOutputStamp");
            var stampLabel = '@Localizer["LastUpdated"]';

            function fmt(v) { return (v === null || v === undefined || isNaN(v)) ? "—" : Number(v).toLocaleString(); }

            function poll() {
                fetch("/WorkOrders/LiveTotals/" + id, { headers: { "Accept": "application/json" } })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (d) {
                        if (!d) return;
                        if (weightEl) weightEl.textContent = fmt(d.totalWeight);
                        if (countEl) countEl.textContent = fmt(d.totalCount);
                        if (stampEl) stampEl.textContent = stampLabel + ": " + new Date().toLocaleTimeString();
                    })
                    .catch(function () { /* keep last-good values on transient errors */ });
            }

            poll();
            setInterval(poll, 10000);
        })();
    </script>
}
