@using System.Globalization
@model List<BetaPlatform.Data.Entities.Product>
@{
    ViewData["Title"] = Localizer["Products"].Value;
    var isAr = CultureInfo.CurrentUICulture.Name == "ar";
    string DisplayName(BetaPlatform.Data.Entities.Product p) =>
        isAr ? p.ProductName : (string.IsNullOrWhiteSpace(p.ProductNameEnglish) ? p.ProductName : p.ProductNameEnglish!);
    var query = ViewData["Query"] as string;
    // Products are master data: administrators only (research D1).
    var isAdmin = User.IsInRole("Admin");
}

<div class="page-header">
    <h1 class="page-title"><span class="title-icon"><i class="bi bi-box-seam"></i></span>@Localizer["Products"]</h1>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i>@Localizer["AddProduct"]</a>
    }
</div>

<form asp-action="Index" method="get" class="mb-3" style="max-width:360px;">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" name="q" value="@query" class="form-control" placeholder="@Localizer["Search"]" />
        <button class="btn btn-outline-primary">@Localizer["Search"]</button>
    </div>
</form>

@if (!Model.Any())
{
    ViewData["EmptyIcon"] = string.IsNullOrEmpty(query) ? "bi-box-seam" : "bi-search";
    ViewData["EmptyTitle"] = Localizer["NoProductsTitle"].Value;
    ViewData["EmptyText"] = Localizer["NoProductsText"].Value;
    ViewData["EmptyActionUrl"] = isAdmin ? Url.Action("Create") : null;
    ViewData["EmptyActionLabel"] = isAdmin ? Localizer["AddProduct"].Value : null;
    <div class="card"><div class="card-body">
        <partial name="_EmptyState" />
    </div></div>
}
else
{
    <div class="card"><div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>@Localizer["ProductCode"]</th>
                    <th>@Localizer["ProductName"]</th>
                    <th>@Localizer["Category"]</th>
                    <th>@Localizer["Unit"]</th>
                    <th>@Localizer["Status"]</th>
                    <th class="text-end">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><span class="fw-semibold">@p.ProductCode</span></td>
                    <td>@DisplayName(p)</td>
                    <td>@p.Category</td>
                    <td>@p.Unit</td>
                    <td>
                        @if (p.IsActive)
                        {
                            <span class="status-badge running">@Localizer["Active"]</span>
                        }
                        else
                        {
                            <span class="status-badge unknown">@Localizer["Inactive"]</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (isAdmin)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.ProductId" title="@Localizer["Edit"]"><i class="bi bi-pencil"></i></a>
                            @if (p.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@p.ProductId" method="post" class="d-inline"
                                      onsubmit="return confirm('@Localizer["Deactivate"]?');">
                                    <button class="btn btn-sm btn-outline-danger" title="@Localizer["Deactivate"]"><i class="bi bi-slash-circle"></i></button>
                                </form>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">&mdash;</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    </div></div>
}
