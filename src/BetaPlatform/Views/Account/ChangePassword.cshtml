@model BetaPlatform.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = Localizer["ChangePassword"].Value;
}

<div class="page-header">
    <div>
        <h1 class="page-title"><span class="title-icon"><i class="bi bi-shield-lock"></i></span>@Localizer["ChangePassword"]</h1>
        <p class="page-subtitle">@User.Identity?.Name</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-arrow-left"></i>@Localizer["Cancel"]</a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post" data-live-form>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="CurrentPassword">@Localizer["CurrentPassword"] <span class="req" title="@Localizer["Required"]">*</span></label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="CurrentPassword" class="field-validation-error small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="NewPassword">@Localizer["NewPassword"] <span class="req" title="@Localizer["Required"]">*</span></label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="changePolicy" />
                        <div class="form-help" id="changePolicy">@Localizer["PasswordPolicyHelp"]</div>
                        <span asp-validation-for="NewPassword" class="field-validation-error small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="ConfirmPassword">@Localizer["ConfirmPassword"] <span class="req" title="@Localizer["Required"]">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error small"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" data-submit-btn>
                            <span class="btn-spinner" aria-hidden="true"></span>
                            <i class="bi bi-check-lg btn-label-icon"></i>@Localizer["Save"]
                        </button>
                        <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">@Localizer["Cancel"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
